# Wibox SIP Configuration File
# Lines starting with # are comments
# Format: key=value

# SIP Configuration
sip_outgoing_call_enabled=1
hangup_on_door_unlock=1
outgoing_call_target=sip:1000@192.168.0.31:5060
outgoing_call_timeout=60
sip_port=5060
rtp_port=8000

# Video Configuration
video_enabled=0
video_rtp_port=8002
video_payload_type=96
video_bitrate_kbps=4096
video_gop_n=25
video_idr_interval=1
video_brc_mode=0
video_rtsp_periodic_idr_ms=0
video_recording_enabled=0
video_recording_path=/tmp/wibox-last-call.h264
video_recording_max_seconds=30
rtsp_enabled=0
rtsp_port=8554
rtsp_auth_user=
rtsp_auth_pass=
# Open the VDS bus line (Fermax auto switch-on) while RTSP/WebRTC clients are
# watching. Required for the stream to carry the panel audio and video instead
# of the noise floor and the blue no-signal screen. Set to 0 to leave the bus
# untouched and only serve what the panel happens to be transmitting.
rtsp_intercom_line_enabled=1
# Safety cap: never hold the VDS bus for longer than this, however long a client
# stays connected (0 disables the cap). On reaching it the line is released and
# not reopened until every client has disconnected, so a forgotten dashboard
# card cannot sit on a shared bus forever.
rtsp_intercom_line_max_seconds=180
# Time zone, POSIX TZ string. The board has no /etc/TZ and its clock has been
# seen alternating between UTC and local time, so the daemon sets it itself.
# Peninsular Spain by default; UK would be GMT0BST,M3.5.0/1,M10.5.0
timezone=CET-1CEST,M3.5.0,M10.5.0/3
# Optional scheduled reboot, in local time. Skipped while a call is up or
# clients are streaming, and retried for an hour after the slot. Off by default.
daily_reboot_enabled=0
daily_reboot_hour=4
daily_reboot_minute=0

# Snapshot Configuration
ring_snapshot_delay_ms=2000

# Local Control Pipe
sip_listen_pipe=/tmp/pipe_sip

# Message Configuration
ding_message=DING

# Intercom serial listener
serial_listener_enabled=1
intercom_device=/dev/ttySGK1
# Minimum delay before this daemon reopens the intercom after a confirmed close.
# Physical-ring snapshots do not open or close the channel and are unaffected.
intercom_reopen_guard_ms=0

# MQTT / Home Assistant
mqtt_enabled=1
mqtt_host=127.0.0.1
mqtt_user=
mqtt_pass=
mqtt_homeassistant_prefix=homeassistant
mqtt_base_topic=
mqtt_device_id=
mqtt_device_name=
firmware_update_enabled=1
firmware_update_repo=segator/wibox-media

# Prometheus metrics exporter
prometheus_enabled=1
prometheus_port=9617

# Hardware watchdog. The boot sequence loads goke_wdt with nowayout=0 so normal
# shutdown and the OTA critical section can disarm it safely.
hardware_watchdog_enabled=1
hardware_watchdog_device=/dev/watchdog
hardware_watchdog_timeout_seconds=30
hardware_watchdog_feed_interval_seconds=5

# Audio Configuration
audio_buffer_size=160
audio_chip_gpio=18
audio_input_gain_percent=35
audio_output_volume_percent=50
audio_line_mute_ms=900
